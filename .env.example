# Spotify -- developer.spotify.com/dashboard (critical: identity anchor)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# YouTube Data v3 -- console.cloud.google.com (10k units/day quota)
YOUTUBE_API_KEY=

# Last.fm -- last.fm/api/account/create
LASTFM_API_KEY=

# Genius (optional) -- genius.com/api-clients
GENIUS_ACCESS_TOKEN=

# MusicBrainz needs no key, only a User-Agent with a REAL contact address.
# It rate-limits to one request a second and answers 503 past that.
MUSICBRAINZ_USER_AGENT=music-research-agent/0.1 (your@email.com)

ANTHROPIC_API_KEY=

# Optional. Set on a public deployment to gate report generation, the only
# action that costs money. Unset, the service behaves as it does locally.
REPORT_TOKEN=

# Free reports a day for visitors without a token. Needs the key-value store to
# count in; without one, a token becomes required instead.
FREE_REPORTS_PER_DAY=20
